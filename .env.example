# Copia este archivo a `.env.local` y pon tu clave real de OpenAI.
# `.env.local` no se sube a git (ver .gitignore).
#
# La app llama a la API a través del proxy de Vite (`npm run dev` o `npm run preview`)
# para no exponer la clave en el navegador.
OPENAI_API_KEY=

# Encuesta NPS → Google Sheet "NPS ULPIK" (Apps Script desplegado como web app)
GOOGLE_SHEETS_NPS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbyjqz0pwRcUM7V1Seercw9oCJ2bC_7XmRaSzcQu8ecec5CODiFfBKSEv979b04L-Ofw/exec
GOOGLE_SHEETS_NPS_WEBHOOK_SECRET=

# Encuesta proceso de compra → Sheet "Ulpik - ¿Cómo fue tu proceso de compra...?"
GOOGLE_SHEETS_COMPRA_WEBAPP_URL=https://script.google.com/macros/s/AKfycbwAnTCKxLUYJwb4tMNAAGxPsUIYO_FofertmW-FhXlCPGj5FoNw7pmUMmarK5RUJIQA/exec
GOOGLE_SHEETS_COMPRA_WEBHOOK_SECRET=

# Pulso del Equipo → Sheet interno (Apps Script con JSONP desde el navegador)
GOOGLE_SHEETS_PULSO_WEBAPP_URL=https://script.google.com/macros/s/AKfycbxXDdmQxXc3rYh5AWzNCs-nkim8L-1fP8YjWK7_w84b7P9cvGwWLNQjGtj2MLQ1A--_ew/exec
